# ---- ECE Pipeline Dashboard configuration ----
# Copy this file to ".env.local" and fill in your Notion token.
#
# 1. Go to https://www.notion.so/my-integrations  ->  "New integration"
#    - Name it e.g. "ECE Dashboard", associate it with your workspace, submit.
#    - Copy the "Internal Integration Secret" (starts with "ntn_" or "secret_").
# 2. Open EACH of the five databases in Notion, click the "..." menu (top-right)
#    -> "Connections" -> add your "ECE Dashboard" integration. Do this for all 5
#    (the Content Ideas and Content Assets DBs are newer — make sure they get
#    connected too, or the Ideas / Visuals screens will be empty).
# 3. Paste the secret below and save the file as ".env.local".
#
# The five database IDs are pre-filled to match your existing pipeline, so you
# normally only need to set NOTION_TOKEN (plus HF_CREDENTIALS for visuals).

NOTION_TOKEN=

# Database IDs (already set to your pipeline's databases — leave as-is unless they change)
NOTION_DB_QUEUE=42fc97c5742546b499fd2b6f240334fd
NOTION_DB_FINDINGS=58c67e76cc884be39775bde5bf6b2c23
NOTION_DB_DRAFTS=0db9b7caa9114bc7a0e18254cf605ca5
NOTION_DB_IDEAS=356b0b5c40f44701a8751209b5b45379
NOTION_DB_ASSETS=1fa418a092294f538fc7ceb18da19711

# ---- Higgsfield (visual generation) ----
# Needed for the "Render visuals" step. Get an API key (id + secret) from your
# Higgsfield account, then set it as a single "id:secret" pair:
HF_CREDENTIALS=
# ...or, equivalently, as two separate values:
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=

# Optional: path to the Claude Code CLI used by the "Run" buttons (research + fact-check).
# Only needed if it isn't at the default location below.
# CLAUDE_BIN=C:\Users\hunch\.local\bin\claude.exe

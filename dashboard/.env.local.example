# ---- ECE Pipeline Dashboard configuration ----
# Copy this file to ".env.local" and fill in your Notion token.
#
# 1. Go to https://www.notion.so/my-integrations  ->  "New integration"
#    - Name it e.g. "ECE Dashboard", associate it with your workspace, submit.
#    - Copy the "Internal Integration Secret" (starts with "ntn_" or "secret_").
# 2. Open EACH of the three databases in Notion, click the "..." menu (top-right)
#    -> "Connections" -> add your "ECE Dashboard" integration. Do this for all 3.
# 3. Paste the secret below and save the file as ".env.local".
#
# The three database IDs are pre-filled to match your existing pipeline, so you
# normally only need to set NOTION_TOKEN.

NOTION_TOKEN=

# Database IDs (already set to your pipeline's databases — leave as-is unless they change)
NOTION_DB_QUEUE=42fc97c5742546b499fd2b6f240334fd
NOTION_DB_FINDINGS=58c67e76cc884be39775bde5bf6b2c23
NOTION_DB_DRAFTS=0db9b7caa9114bc7a0e18254cf605ca5
